# =======================
# Application
# =======================
SPRING_PROFILES_ACTIVE=prod

# =======================
# Main Database (PostgreSQL)
# =======================
SPRING_DATASOURCE_MAIN_URL=jdbc:postgresql://postgres:5432/netfliz
SPRING_DATASOURCE_MAIN_USERNAME=netfliz
SPRING_DATASOURCE_MAIN_PASSWORD=your_secure_password

# =======================
# Analysis Database (PostgreSQL)
# =======================
SPRING_DATASOURCE_ANALYSIS_URL=jdbc:postgresql://postgres:5432/netfliz_analysis
SPRING_DATASOURCE_ANALYSIS_USERNAME=netfliz
SPRING_DATASOURCE_ANALYSIS_PASSWORD=your_secure_password

# =======================
# PostgreSQL Container
# =======================
POSTGRES_USER=netfliz
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=netfliz

# =======================
# Kafka
# =======================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# =======================
# Email (Gmail SMTP)
# =======================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
